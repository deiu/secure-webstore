{
  "name": "secure-webstore",
  "version": "1.3.7",
  "description": "Secure IndexedDB store using encryption",
  "author": "Andrei Sambra <andrei.sambra@gmail.com>",
  "license": "MIT",
  "keywords": [
    "indexeddb",
    "webcrypto api",
    "cryptography",
    "key derivation",
    "secure storage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deiu/secure-webstore.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cjs/secure-webstore": {
      "types": "./dist/cjs/secure-webstore.d.ts",
      "require": "./dist/cjs/secure-webstore.js"
    },
    "./esm/secure-webstore": {
      "types": "./dist/esm/secure-webstore.d.mts",
      "import": "./dist/esm/secure-webstore.mjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "easy-web-crypto": "^1.4.0"
  },
  "overrides": {
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
